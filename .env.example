# ==============================================================================
# Compliance Centras - Конфигурация окружения (.env)
# ==============================================================================
#
# БЫСТРЫЙ СТАРТ:
# 1. Локально:
#      pip install -r requirements.txt
#      python run.py
# 2. В Docker (PostgreSQL + pgvector):
#      docker-compose up -d --build
#
# Вход в веб-интерфейс:
#      URL:      http://localhost:8000
#      Email:    admin@cic.kz
#      Пароль:   Holding22#
# ==============================================================================

# --- AI & Gemini API (Google AI Studio) ---
# Получите бесплатный ключ на https://aistudio.google.com/
GEMINI_API_KEY=

# Основная модель Gemini для юридического анализа, черновиков и аудита
GEMINI_MODEL=gemini-3.1-flash-lite

# Модель для поиска НПА в реальном времени с Google Search Grounding
GEMINI_GROUNDING_MODEL=gemini-2.5-flash

# Модель векторных эмбеддингов (768 dimensions)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- База данных ---
# Локальная разработка (по умолчанию SQLite):
DATABASE_URL=sqlite:///./compliance_centras.db

# Продакшн в Docker (раскомментируйте при работе с PostgreSQL + pgvector):
# DATABASE_URL=postgresql://admin:secretpassword@localhost:5432/complience

# Настройки пула соединений PostgreSQL (production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# --- Безопасность и JWT ---
# Секретный ключ для подписи JWT токенов
JWT_SECRET=super-secret-key-compliance-centras-2026-prod-token

# Разрешенные CORS-домены (через запятую, либо * для всех)
ALLOWED_ORIGINS=*

# --- Уведомления и алерты (Опционально) ---
# Исходящий HTTP Webhook для отправки комплаенс-событий в корпоративную шину / Slack
WEBHOOK_URL=

# Telegram Bot для мгновенных оповещений офицера комплаенса
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Сетевые настройки и сервер ---
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=2
RELOAD=false
LOG_LEVEL=info
